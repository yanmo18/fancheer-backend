# 服务端口（与 fancheer-frontend/vite.config.ts 代理目标保持一致）
PORT=3001

# MySQL/MariaDB 数据库连接（Prisma 使用，必填）
# 格式：mysql://用户名:密码@主机:端口/数据库名
# MySQL 8 本地开发若报 pool timeout / RSA public key，可加：?allowPublicKeyRetrieval=true
DATABASE_URL="mysql://user:password@localhost:3306/fancheer?allowPublicKeyRetrieval=true"

# Redis 缓存（验证码、JWT 黑名单、限流等，非数据库）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥（必填，未配置时服务拒绝启动）
# 生产环境请使用强随机字符串，如：openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# 生产环境 CORS 白名单（逗号分隔多个域名）
# 留空或不设置：开发模式允许所有来源
# 生产环境示例（本地前端默认端口为 5174）：
# CORS_ORIGIN=http://localhost:5174,https://your-frontend.com

# 置于 Nginx/负载均衡后时设为 true，使限流与日志使用 X-Forwarded-For
# TRUST_PROXY=true

# 生产启动请设为 production（pnpm start / Docker 通常已注入），以启用 HSTS 等头
# NODE_ENV=production

# 可选：音频转码用的 ffmpeg 绝对路径（码率 >192kbps 时压成 192kbps MP3）
# Windows winget 安装 Gyan.FFmpeg 后若不在 PATH，可填类似：
# FFMPEG_PATH=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-9.0.2-full_build\bin\ffmpeg.exe
# 也可：winget install Gyan.FFmpeg 后新开终端，确认 where ffmpeg 有输出
# FFMPEG_PATH=
