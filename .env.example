# 服务端口（默认 3000）
PORT=3000

# MySQL/MariaDB 数据库连接（Prisma 使用，必填）
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://user:password@localhost:3306/fancheer"

# Redis 缓存（验证码、JWT 黑名单、限流等，非数据库）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 密钥（必填，未配置时服务拒绝启动）
# 生产环境请使用强随机字符串，如：openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production

# 生产环境 CORS 白名单（逗号分隔多个域名）
# 留空或不设置：开发模式允许所有来源
# 生产环境示例：
# CORS_ORIGIN=http://localhost:5173,https://your-frontend.com
