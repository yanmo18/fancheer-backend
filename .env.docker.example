# Docker Compose 环境变量（复制为 .env.docker 后修改）
# 用法：docker compose --env-file .env.docker up -d --build

# 对外 HTTP 端口（Nginx 入口）
HTTP_PORT=8080

# MariaDB
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=fancheer
MYSQL_USER=fancheer
MYSQL_PASSWORD=change-db-password

# Redis（默认无密码，生产可设置）
REDIS_PASSWORD=

# 后端 JWT（必填，请改为强随机字符串）
# 生成示例：openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-secret

# 浏览器访问前端的完整地址（逗号分隔多个域名）
# 通过 Nginx 反代时，前后端同源，此项主要用于直接访问 API 的场景
CORS_ORIGIN=http://localhost:8080

# 首次启动是否写入种子数据（streamer/admin/fan001，密码 123456）
# 生产环境首次初始化可设为 true，之后改回 false
SEED_ON_START=false
